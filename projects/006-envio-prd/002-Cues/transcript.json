      "audio": "turns/t0006-Claude.wav",
      "seed": 47,
      "effect": "robot-soft",
      "reused_audio": true,
      "exaggeration": 0.2
    },
    {
      "id": "t0007",
      "speaker": "Yo",
      "profile": "mi-voz",
      "text": "¡¿Y QUÉ HICISTE CON ELLA?!",
