  "segments": [
    {
      "text": "Claude, solo necesito que cambies este botón de azul a verde.",
      "start": 0.0,
      "end": 3.265833333333333,
      "turn": "t0001",
      "speaker": "Yo"
    },
    {
      "text": "¡Entendido!",
      "start": 3.6858333333333335,
      "end": 4.785833333333334,
      "turn": "t0002",
      "speaker": "Claude"
    },
    {
      "text": "He rediseñado completamente la arquitectura.",
      "start": 4.969166666666667,
      "end": 7.702500000000001,
      "turn": "t0002",
      "speaker": "Claude"
    },
    {
      "text": "¿Cómo que rediseñado?",
      "start": 8.128458333333333,
      "end": 9.461791666666667,
      "turn": "t0003",
      "speaker": "Yo"
    },
    {
      "text": "Ahora tenemos treinta microservicios, Kubernetes, Kafka y una arquitectura orientada a eventos.",
      "start": 9.883791666666667,
      "end": 15.817125,
      "turn": "t0004",
      "speaker": "Claude"
    },
    {
      "text": "¡Pero solo quería cambiar el color de un botón!",
      "start": 16.240458333333333,
      "end": 18.373791666666666,
      "turn": "t0005",
      "speaker": "Yo"
    },
    {
      "text": "Lo sé.",
      "start": 18.796541666666666,
      "end": 19.529875,
      "turn": "t0006",
      "speaker": "Claude"
    },
    {
      "text": "También implementé escalamiento automático para soportar diez millones de usuarios.",
      "start": 19.713208333333334,
      "end": 24.479875,
      "turn": "t0006",
      "speaker": "Claude"
    },
    {
      "text": "¿Y cuántos usuarios tenemos?",
      "start": 24.90025,
      "end": 26.433583333333335,
      "turn": "t0007",
      "speaker": "Yo"
    },
    {
      "text": "Tres.",
      "start": 26.861,
      "end": 27.661,
      "turn": "t0008",
      "speaker": "Claude"
    },
    {
      "text": "Contándote a ti.",
      "start": 27.844333333333335,
      "end": 28.942041666666668,
      "turn": "t0008",
      "speaker": "Claude"
    },
    {
      "text": "¿Y el botón?",
      "start": 29.545375,
      "end": 30.678708333333333,
      "turn": "t0009",
      "speaker": "Yo"
    },
    {
      "text": "Sigue azul.",
      "start": 31.100375,
      "end": 32.16704166666667,
      "turn": "t0010",
      "speaker": "Claude"
    }
  ],
