      "audio": "turns/t0004-Claude.wav",
      "seed": 45,
      "effect": "robot-soft",
      "reused_audio": true,
      "exaggeration": 0.2
    },
    {
      "id": "t0005",
      "speaker": "Yo",
      "profile": "mi-voz",
      "text": "¿¡QUÉ!? ¡Ese archivo tiene nuestras credenciales!",
      "start": 13.349625,
